# BPÜ Pipeline — Umgebungsvariablen
# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env wird NICHT ins Repository committed.

# Pfad zur Datenordner-Struktur (relativ zum Repo-Root oder absolut)
DATA_DIR=./data

# OpenAI API Key für KI-Konfig-Generierung (M2)
OPENAI_API_KEY=sk-XXXXX

# OpenAI API Base URL (leer = Standard https://api.openai.com/v1)
OPENAI_BASE_URL=https://adesso-ai-hub.3asabc.de/v1

# OpenAI Modell (Standard: gpt-4o)
OPENAI_MODEL=gemini-3-pro-preview

# Konfidenz-Schwellwert für automatisches Speichern (0-100, Standard: 85)
KONFIDENZ_SCHWELLWERT=85

# Next.js Frontend URL (für CORS, M3)
FRONTEND_URL=http://localhost:3000

# FastAPI Backend URL (für Next.js, M3)
NEXT_PUBLIC_API_URL=http://localhost:8000
